# Choose LLM Provider: 'gemini' | 'anthropic' | 'local'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (leave blank to run in local deterministic mode)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
